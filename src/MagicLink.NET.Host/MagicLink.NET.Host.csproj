<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The container image's app (issue #12): a thin host around MagicLink.NET and MagicLink.NET.PostgreSql that takes its
    settings from configuration and environment variables, published as a Native AOT binary. Not a NuGet package.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <RootNamespace>MagicLink.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MagicLink.NET\MagicLink.NET.csproj" />
    <ProjectReference Include="..\MagicLink.NET.PostgreSql\MagicLink.NET.PostgreSql.csproj" />
  </ItemGroup>
</Project>
