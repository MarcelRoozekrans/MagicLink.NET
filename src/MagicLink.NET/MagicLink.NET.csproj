<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MagicLink.NET</PackageId>
    <Description>A small OpenID Connect provider that signs people in with a link or a short code sent by email. Host it in an ASP.NET Core app with services.Add..., or run it on its own.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="OpenIddict.Core" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="ZeroAlloc.Resilience" />
    <PackageReference Include="ZeroAlloc.Results" />
  </ItemGroup>
  <!-- The tests also check internals, such as the mail queue and the sign-in requests in the store. -->
  <ItemGroup>
    <InternalsVisibleTo Include="MagicLink.NET.Tests" />
  </ItemGroup>
</Project>
