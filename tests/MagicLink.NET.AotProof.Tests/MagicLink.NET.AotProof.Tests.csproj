<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>MagicLink.AotProof.Tests</RootNamespace>
    <!-- In xUnit test projects, ConfigureAwait(false) is forbidden by xUnit1030; suppress MA0004 here. -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <!-- A database of its own for the restart test, as the store's tests have. -->
  <ItemGroup>
    <Compile Include="..\MagicLink.NET.PostgreSql.Tests\PostgresDatabase.cs" Link="PostgresDatabase.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\samples\MagicLink.NET.AotProof\MagicLink.NET.AotProof.csproj" />
  </ItemGroup>
</Project>
