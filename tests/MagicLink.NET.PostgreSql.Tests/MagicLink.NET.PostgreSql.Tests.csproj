<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>MagicLink.PostgreSql.Tests</RootNamespace>
    <!-- In xUnit test projects, ConfigureAwait(false) is forbidden by xUnit1030; suppress MA0004 here. -->
    <NoWarn>$(NoWarn);MA0004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <!-- The job table scripts the package ships, compared with the migrations that run. -->
  <ItemGroup>
    <None Include="..\..\src\MagicLink.NET.PostgreSql\JobStoreMigrations\*.sql" LinkBase="JobStoreMigrations" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MagicLink.NET.PostgreSql\MagicLink.NET.PostgreSql.csproj" />
  </ItemGroup>
</Project>
