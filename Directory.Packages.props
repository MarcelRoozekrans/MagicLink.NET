<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers, referenced by every project through Directory.Build.props. -->
  <ItemGroup>
    <PackageVersion Include="ErrorProne.NET.CoreAnalyzers" Version="0.1.2" />
    <PackageVersion Include="ErrorProne.NET.Structs" Version="0.1.2" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.13.1" />
  </ItemGroup>

  <!-- OpenIddict (ADR-010) -->
  <ItemGroup>
    <PackageVersion Include="OpenIddict.Core" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.9.0" />
    <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.9.0" />
  </ItemGroup>

  <!-- Retrying the sign-in email (ADR-015) -->
  <ItemGroup>
    <PackageVersion Include="ZeroAlloc.Resilience" Version="3.5.1" />
  </ItemGroup>

  <!-- Expected failures as values (product-line standards) -->
  <ItemGroup>
    <PackageVersion Include="ZeroAlloc.Results" Version="1.5.1" />
  </ItemGroup>

  <!-- PostgreSQL store (ADR-016) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Npgsql" Version="10.0.4" />
    <PackageVersion Include="ZeroAlloc.ORM" Version="2.16.1" />
    <PackageVersion Include="ZeroAlloc.ORM.Generator" Version="2.16.1" />
    <PackageVersion Include="ZeroAlloc.Scheduling" Version="2.5.0" />
    <PackageVersion Include="ZeroAlloc.Scheduling.Orm" Version="2.5.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
