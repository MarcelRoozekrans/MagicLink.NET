<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Proof that OpenIddict's server stack runs under Native AOT (issue #1, ADR-016). Not shipped. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>MagicLink.AotProof</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenIddict.Core" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" />
  </ItemGroup>
</Project>
